# PostgreSQL 접속 문자열 — 설정하면 PostgresAdapter(영구 저장)를 사용합니다.
# 비워 두면 로컬 인메모리 개발 어댑터로 동작합니다(재시작 시 초기화).
# Supabase: Project Settings → Database → Connection pooling(Transaction) URI 권장.
DATABASE_URL=

# 세션 쿠키 서명 키. 프로덕션에서는 필수입니다(미설정 시 서버가 기동을 거부).
# 생성 예: openssl rand -base64 32
AUTH_SECRET=

# Google 로그인 (OAuth 2.0). 둘 다 있어야 로그인 화면에 버튼이 나타납니다.
# console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 →
#   OAuth 클라이언트 ID(웹 애플리케이션)를 만들고,
#   "승인된 리디렉션 URI"에 아래 주소를 **그대로** 등록하세요.
#     http://localhost:3000/api/auth/google/callback   (로컬 개발)
#     https://<배포도메인>/api/auth/google/callback     (배포)
# GOOGLE_CLIENT_SECRET은 서버 전용 — 브라우저에 절대 노출하지 마세요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Creem 결제 (30분 라운지 이용권). 서버 전용 — 브라우저에 절대 노출 금지.
# 키가 없으면 결제 버튼이 "결제 준비 중"으로 표시되며 결제가 시작되지 않습니다.
CREEM_API_KEY=
# 웹훅 서명 검증용. 없으면 웹훅을 503으로 거부합니다(검증 없는 지급 방지).
CREEM_WEBHOOK_SECRET=
# test(기본) | live — test는 test-api.creem.io를 사용합니다.
CREEM_MODE=test
#
# Creem 대시보드에서 만든 상품 ID. 채워진 상품만 실제로 판매됩니다.
CREEM_ONE_TIME_PRODUCT_ID=
CREEM_LIGHT_PRODUCT_ID=
CREEM_GOLD_PRODUCT_ID=
CREEM_BLACK_VIP_PRODUCT_ID=
# 시간 연장 상품 (선택). 영상 라운지 안에서 팔리며, 채운 상품만 방에 나타납니다.
CREEM_EXTEND_10_PRODUCT_ID=
CREEM_EXTEND_30_PRODUCT_ID=
# 부담자가 아닌 참가자가 방 시간을 대신 늘려 주는 상품.
CREEM_GIFT_EXTEND_30_PRODUCT_ID=
#
# 아래 둘은 이행 로직이 없어 ID를 채워도 판매되지 않습니다(체크아웃이 거부).
CREEM_REMATCH_NOW_PRODUCT_ID=
CREEM_FILTERED_MATCH_PRODUCT_ID=

# Supabase — (향후 인증 연동용) 데이터 접근에는 위 DATABASE_URL을 사용합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 브라우저에 절대 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# Daily 화상. 서버 전용 — 브라우저에 절대 노출하지 마세요.
# dashboard.daily.co → Developers → API key. 비워 두면 화상 없이(채팅만) 동작합니다.
DAILY_API_KEY=
VIDEO_TEST_SECRET=

# 운영시간 게이트: 1이면 실제 운영시간(저녁 6시~새벽 4시) 적용, 비우면 상시 오픈.
CLUBON_ENFORCE_HOURS=

# 클럽 운영 시간 기준 타임존
CLUB_TIMEZONE=Asia/Seoul
